+        ViewGroup root = (ViewGroup) LayoutInflater.from(activity).inflate(R.layout.player, null);
+        activity.setContentView(root);
+        SurfaceController surface = new SurfaceController(root);
+        surface.setScreenSize(1920, 1080);
+        surface.setVideoSize(1920, 1080, 1.0);
+        surface.setMediaPlayer(mock(IMediaPlayer.class));
+        surface.setManualZoom(true, 150);
