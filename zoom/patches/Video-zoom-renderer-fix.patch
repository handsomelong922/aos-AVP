+/* SPDX-License-Identifier: Apache-2.0 */
+package com.archos.mediacenter.video.player;
+
+public final class LegacyTvManualZoomTest {
+    public static void main(String[] args) {
+        check(LegacyTvManualZoom.useTexture(28, true, true, true, true, false));
+        check(!LegacyTvManualZoom.useTexture(29, true, true, true, true, false));
+        check(!LegacyTvManualZoom.useTexture(28, false, true, true, true, false));
+        check(!LegacyTvManualZoom.useTexture(28, true, false, true, true, false));
+        check(!LegacyTvManualZoom.useTexture(28, true, true, false, true, false));
+        check(!LegacyTvManualZoom.useTexture(28, true, true, true, false, false));
+        check(!LegacyTvManualZoom.useTexture(28, true, true, true, true, true));
+        check(LegacyTvManualZoom.isSafeSdr(1, "H.265", 0));
+        check(LegacyTvManualZoom.isSafeSdr(0, "H.264", 0));
+        check(LegacyTvManualZoom.isSafeSdr(2, "AVC", 0));
+        check(!LegacyTvManualZoom.isSafeSdr(0, "HEVC", 0));
+        check(!LegacyTvManualZoom.isSafeSdr(16, "H.264", 0));
+        check(!LegacyTvManualZoom.isSafeSdr(18, "H.265", 0));
+        check(!LegacyTvManualZoom.isSafeSdr(1, "Dolby Vision", 0));
+        check(!LegacyTvManualZoom.isSafeSdr(1, "H.264", 1));
+
+        LegacyTvManualZoom.Transform same = LegacyTvManualZoom.transform(1920, 1080, 1920, 1080);
+        close(same.scaleX, 1);
+        close(same.scaleY, 1);
+        close(same.pivotX, 960);
+        close(same.pivotY, 540);
+        LegacyTvManualZoom.Transform zoomed = LegacyTvManualZoom.transform(1920, 1080, 2880, 1620);
+        close(zoomed.scaleX, 1.5);
+        close(zoomed.scaleY, 1.5);
+        close(zoomed.pivotX, 960);
+        close(zoomed.pivotY, 540);
+        LegacyTvManualZoom.Transform wide = LegacyTvManualZoom.transform(1920, 1080, 1920, 800);
+        close(wide.scaleX, 1);
+        close(wide.scaleY, 800.0 / 1080);
+        check(LegacyTvManualZoom.transform(0, 1080, 1920, 1080) == null);
+        System.out.println("Android 9 TV renderer scope, HDR/stereo guards, and bounded center transform passed");
+    }
+
+    private static void close(double actual, double expected) {
+        check(Math.abs(actual - expected) < 0.0001);
+    }
+
+    private static void check(boolean expression) {
+        if (!expression) throw new AssertionError("Incorrect legacy TV zoom renderer policy");
+    }
+}
