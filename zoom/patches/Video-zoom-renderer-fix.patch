+/* SPDX-License-Identifier: Apache-2.0 */
+package com.archos.mediacenter.video.player;
+
+import java.util.Locale;
+
+/** A bounded 2D TextureView compositor for the affected Android TV generation. */
+final class LegacyTvManualZoom {
+    private LegacyTvManualZoom() {}
+
+    static boolean useTexture(int sdk, boolean television, boolean normalOutput,
+            boolean manualActive, boolean safeSdr, boolean outputRejected) {
+        return sdk == 28 && television && normalOutput && manualActive && safeSdr && !outputRejected;
+    }
+
+    static boolean isSafeSdr(int transfer, String format, int stereoMode) {
+        if (stereoMode != 0 || format == null || format.isEmpty()) return false;
+        String codec = format.toLowerCase(Locale.ROOT);
+        if (codec.contains("dolby") || codec.contains("dovi") || codec.contains("dvhe")
+                || codec.contains("dvh1") || codec.contains("dvav")) return false;
+        return switch (transfer) {
+            // AVCOL_TRC: BT.709, gamma 2.2/2.8, SMPTE 170/240, sRGB, BT.2020 SDR.
+            case 1, 4, 5, 6, 7, 13, 14, 15 -> true;
+            // Untagged AVC is commonly SDR. Unknown HEVC/VP9/AV1 stay on SurfaceView.
+            case 0, 2 -> codec.contains("h.264") || codec.contains("h264") || codec.contains("avc");
+            default -> false; // Includes PQ, HLG and other unverified transfer curves.
+        };
+    }
+
+    static Transform transform(int viewportWidth, int viewportHeight, int pictureWidth, int pictureHeight) {
+        if (viewportWidth <= 0 || viewportHeight <= 0 || pictureWidth <= 0 || pictureHeight <= 0) return null;
+        return new Transform(pictureWidth / (float) viewportWidth, pictureHeight / (float) viewportHeight,
+                viewportWidth / 2f, viewportHeight / 2f);
+    }
+
+    static final class Transform {
+        final float scaleX, scaleY, pivotX, pivotY;
+
+        Transform(float scaleX, float scaleY, float pivotX, float pivotY) {
+            this.scaleX = scaleX;
+            this.scaleY = scaleY;
+            this.pivotX = pivotX;
+            this.pivotY = pivotY;
+        }
+    }
+}
