+        TextureView target = root.findViewById(R.id.manual_zoom_texture);
+        assertSame(target, surface.getView());
+        assertEquals(View.VISIBLE, target.getVisibility());
+        View backdrop = root.findViewById(R.id.manual_zoom_backdrop);
+        assertEquals(View.VISIBLE, backdrop.getVisibility());
+        assertEquals(Color.BLACK, ((ColorDrawable) backdrop.getBackground()).getColor());
+        assertFalse(surface.supportOpenGLVideoEffect());
+        assertEquals(1920, target.getLayoutParams().width);
+        assertEquals(1080, target.getLayoutParams().height);
+        assertEquals(2880, surface.getViewWidth());
+        assertEquals(1620, surface.getViewHeight());
+        assertEquals(-480, surface.getVideoBoxLeft());
+        assertEquals(-270, surface.getVideoBoxTop());
+
+        Matrix matrix = target.getTransform(new Matrix());
+        float[] points = {0, 0, 960, 540, 1920, 1080};
+        matrix.mapPoints(points);
+        float[] expected = {-480, -270, 960, 540, 2400, 1350};
+        for (int i = 0; i < points.length; i++) assertEquals(expected[i], points[i], 0.05f);
+
+        surface.setManualZoom(true, 151);
+        assertSame(target, surface.getView());
+        assertEquals(1920, target.getLayoutParams().width);
+        assertEquals(1080, target.getLayoutParams().height);
+        assertEquals(2899, surface.getViewWidth());
+        assertEquals(1631, surface.getViewHeight());
+
+        surface.setGLSupportEnabled(true);
+        assertFalse(surface.isDirectZoomOutput());
+        assertEquals(View.GONE, backdrop.getVisibility());
+        assertSame(root.findViewById(R.id.gl_surface_view), surface.getView());
+        surface.setGLSupportEnabled(false);
+        assertSame(root.findViewById(R.id.surface_view), surface.getView());
+    }
+
+    @Test
+    public void directCallbackBindsRawProducerAndClearsOnlyThatTextureOnDestroy() throws Exception {
+        Activity activity = Robolectric.buildActivity(Activity.class).setup().get();
+        ViewGroup root = (ViewGroup) LayoutInflater.from(activity).inflate(R.layout.player, null);
+        SurfaceController surface = new SurfaceController(root);
+        Player player = emptyPlayer();
+        ReflectionHelpers.setField(player, "mContext", activity);
+        ReflectionHelpers.setField(player, "mHandler", new Handler(Looper.getMainLooper()));
+        ReflectionHelpers.setField(player, "mSurfaceController", surface);
+        surface.setTextureCallback(player);
+        TextureView view = root.findViewById(R.id.manual_zoom_texture);
+        TextureView.SurfaceTextureListener direct = view.getSurfaceTextureListener();
+        SurfaceTexture texture = new SurfaceTexture(7);
+        SurfaceTexture other = new SurfaceTexture(8);
+        surface.setDirectZoomOutput(true);
+        try {
+            direct.onSurfaceTextureAvailable(texture, 1920, 1080);
+            assertSame(texture, ReflectionHelpers.getField(player, "mVideoTexture"));
+            assertNull(ReflectionHelpers.getField(player, "mEffectRenderer"));
+            assertNull(ReflectionHelpers.getField(player, "mUISurface"));
+            assertTrue(direct.onSurfaceTextureDestroyed(other));
+            assertSame(texture, ReflectionHelpers.getField(player, "mVideoTexture"));
+            assertTrue(direct.onSurfaceTextureDestroyed(texture));
+            assertNull(ReflectionHelpers.getField(player, "mVideoTexture"));
+        } finally {
+            texture.release();
+            other.release();
+        }
+    }
+
+    private static Player emptyPlayer() throws Exception {
+        // Do not try to load the device AVOS .so in app-side JVM tests.
+        Class<?> unsafeClass = Class.forName("sun.misc.Unsafe");
+        Field instance = unsafeClass.getDeclaredField("theUnsafe");
+        instance.setAccessible(true);
+        Method allocate = unsafeClass.getMethod("allocateInstance", Class.class);
+        return (Player) allocate.invoke(instance.get(null), Player.class);
+    }
+}
