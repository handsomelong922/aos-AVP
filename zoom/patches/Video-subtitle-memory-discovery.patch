+/* SPDX-License-Identifier: Apache-2.0 */
+package com.archos.mediacenter.video.browser.subtitlesmanager;
+
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** Conservative, filename-only matching for local auto-discovery; never opens a source. */
+public final class LocalSubtitleMatch {
+    private static final Pattern EPISODE = Pattern.compile(
+            "(?:^|[^\\p{L}\\p{N}])(?:s(\\d{1,3})e(\\d{1,4})|(\\d{1,3})x(\\d{1,4}))(?=$|[^\\p{L}\\p{N}])",
+            Pattern.CASE_INSENSITIVE);
+    private static final Pattern OWNED_DISPLAY = Pattern.compile(
+            "^(.*)\\.nova-(?:local|manual)-[a-f0-9]{24}-[a-f0-9]{24}\\.(.+)$");
+    private static final Set<String> LANGUAGES = new HashSet<>();
+    static {
+        for (String language : Locale.getISOLanguages()) {
+            LANGUAGES.add(language);
+            try {
+                LANGUAGES.add(Locale.forLanguageTag(language).getISO3Language());
+            } catch (java.util.MissingResourceException unavailable) {
+                // Some vendor builds ship a reduced locale table.
+            }
+        }
+        java.util.Collections.addAll(LANGUAGES, "chs", "cht", "zho", "chi", "und");
+    }
+
+    private LocalSubtitleMatch() {}
+
+    public static String stem(String name) {
+        int dot = name != null ? name.lastIndexOf('.') : -1;
+        return name == null ? "" : dot > 0 ? name.substring(0, dot) : name;
+    }
+
+    public static String leaf(String path) {
+        if (path == null) return "";
+        return path.substring(path.lastIndexOf('/') + 1);
+    }
+
+    public static boolean matches(String videoName, String subtitleName) {
+        return variant(videoName, subtitleName) != null;
+    }
+
+    /** Relative extension and a validated label, e.g. zh-hant.ass, never the earlier episode's name. */
+    public static String variant(String videoName, String subtitleName) {
+        if (subtitleName == null || subtitleName.lastIndexOf('.') <= 0) return null;
+        String video = stem(videoName).toLowerCase(Locale.ROOT);
+        String subtitle = stem(subtitleName).toLowerCase(Locale.ROOT);
+        if (video.isEmpty()) return null;
+        String extension = subtitleName.substring(subtitleName.lastIndexOf('.') + 1).toLowerCase(Locale.ROOT);
+        String label = null;
+        if (subtitle.equals(video)) label = "";
+        else if (subtitle.startsWith(video + ".")) {
+            String extra = subtitle.substring(video.length() + 1);
+            if (isLabel(extra, true)) label = extra;
+        }
+        if (label == null) {
+            Episode v = episode(video);
+            Episode s = episode(subtitle);
+            if (v != null && s != null && v.series.equals(s.series)
+                    && v.season == s.season && v.episode == s.episode) {
+                String tail = subtitle.substring(s.end).replaceFirst("^[ ._\\-]+", "");
+                // Different release/episode titles can be safe only if the series+episode are exact;
+                // an unknown trailing label is not inferred as a reusable preference.
+                if (!tail.isEmpty() && !isLabel(tail, false)) return null;
+                label = tail;
+            }
+        }
+        return label == null ? null : label + "." + extension;
+    }
+
+    /** Unique owned cache namespace; the filename still starts with the video stem for AVOS. */
+    public static String cachePrefix(String videoName, String videoIdentity) {
+        return stem(videoName) + ".nova-local-" + digestTag(videoIdentity) + "-";
+    }
+
+    public static String cacheName(String videoName, String videoIdentity, String sidecarIdentity, String variant) {
+        return cachePrefix(videoName, videoIdentity) + digestTag(stem(sidecarIdentity)) + "." + variant;
+    }
+
+    public static String manualCacheName(String videoName, String videoIdentity, String sidecarIdentity, String variant) {
+        return manualCachePrefix(videoName, videoIdentity) + digestTag(stem(sidecarIdentity)) + "." + variant;
+    }
+
+    public static String manualCachePrefix(String videoName, String videoIdentity) {
+        return stem(videoName) + ".nova-manual-" + digestTag(videoIdentity) + "-";
+    }
+
+    public static String cachedVariant(String videoName, String videoIdentity, String subtitleName) {
+        String prefix = cachePrefix(videoName, videoIdentity);
+        if (!subtitleName.startsWith(prefix)) {
+            prefix = manualCachePrefix(videoName, videoIdentity);
+            if (!subtitleName.startsWith(prefix)) return null;
+        }
+        String rest = subtitleName.substring(prefix.length());
+        int dot = rest.indexOf('.');
+        return dot == 24 && rest.substring(0, dot).matches("[a-f0-9]{24}")
+                && dot + 1 < rest.length() ? rest.substring(dot + 1) : null;
+    }
+
+    private static String digestTag(String value) {
+        try {
+            byte[] digest = java.security.MessageDigest.getInstance("SHA-256")
+                    .digest(value.getBytes(java.nio.charset.StandardCharsets.UTF_8));
+            StringBuilder out = new StringBuilder(24);
+            for (int i = 0; i < 12; i++) {
+                out.append(Character.forDigit((digest[i] >>> 4) & 15, 16));
+                out.append(Character.forDigit(digest[i] & 15, 16));
+            }
+            return out.toString();
+        } catch (java.security.NoSuchAlgorithmException e) {
+            throw new AssertionError("Android requires SHA-256", e);
+        }
+    }
+
+    static String ownedDisplayName(String name) {
+        if (name == null) return null;
+        Matcher match = OWNED_DISPLAY.matcher(name);
+        if (!match.matches()) return name;
+        String variant = match.group(2);
+        if (variant.startsWith("manual.")) return match.group(1) + variant.substring("manual".length());
+        return match.group(1) + (variant.startsWith(".") ? "" : ".") + variant;
+    }
+
+    public static boolean hasOwnedMarker(String subtitleName) {
+        return subtitleName.contains(".nova-local-") || subtitleName.contains(".nova-manual-");
+    }
+
+    public static String series(String videoName) {
+        Episode episode = episode(stem(videoName).toLowerCase(Locale.ROOT));
+        return episode == null ? null : episode.series + ":" + episode.season;
+    }
+
+    public static boolean dedicatedDirectory(String videoName, String directory) {
+        return directory != null && !directory.isEmpty() && stem(videoName).equalsIgnoreCase(directory);
+    }
+
+    public static boolean generic(String subtitleName) {
+        String name = stem(subtitleName).toLowerCase(Locale.ROOT);
+        return !name.isEmpty() && isLabel(name, false);
+    }
+
+    private static boolean isLabel(String value, boolean allowIndex) {
+        for (String label : value.split("\\.", -1)) {
+            if (allowIndex && label.matches("[0-9]{1,3}")) continue;
+            if (label.equals("forced") || label.equals("sdh") || label.equals("cc")
+                    || label.equals("default") || label.equals("简体") || label.equals("繁体")) continue;
+            String[] parts = label.split("[-_]", -1);
+            if (!LANGUAGES.contains(parts[0])) return false;
+            for (int i = 1; i < parts.length; i++) {
+                if (!parts[i].matches("[a-z]{2}|[a-z]{4}|[0-9]{3}")) return false;
+            }
+        }
+        return true;
+    }
+
+    private static Episode episode(String stem) {
+        Matcher matcher = EPISODE.matcher(stem);
+        if (!matcher.find()) return null;
+        String series = stem.substring(0, matcher.start()).replaceAll("[^\\p{L}\\p{N}]+", " ").trim();
+        if (series.isEmpty()) return null;
+        Episode result = new Episode(series,
+                Integer.parseInt(matcher.group(1) != null ? matcher.group(1) : matcher.group(3)),
+                Integer.parseInt(matcher.group(2) != null ? matcher.group(2) : matcher.group(4)),
+                matcher.end());
+        return matcher.find() ? null : result; // Multi-episode release is deliberately not inferred.
+    }
+
+    private static final class Episode {
+        final String series;
+        final int season, episode, end;
+        Episode(String series, int season, int episode, int end) {
+            this.series = series;
+            this.season = season;
+            this.episode = episode;
+            this.end = end;
+        }
+    }
+}
