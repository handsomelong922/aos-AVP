new file mode 100644
index 0000000..4c9bc97
--- /dev/null
+++ b/src/main/java/com/archos/mediacenter/video/player/VideoZoomLayout.java
@@ -0,0 +1,53 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.archos.mediacenter.video.player;
+
+/** Aspect-preserving destination size; intentionally independent of the decoded buffer size. */
+final class VideoZoomLayout {
+    // Largest size representable by Android's 30-bit MeasureSpec size field.
+    private static final int MAX_LAYOUT_SIZE = 0x3fffffff;
+
+    static final int MANUAL_MIN_PERCENT = 100;
+    private static final int MANUAL_MAX_PERCENT = 200;
+
+    private VideoZoomLayout() {}
+
+    static int clampManualPercent(int percent) {
+        return Math.min(MANUAL_MAX_PERCENT, Math.max(MANUAL_MIN_PERCENT, percent));
+    }
+
+    static int stepManualPercent(int percent, boolean increase) {
+        return clampManualPercent(clampManualPercent(percent) + (increase ? 1 : -1));
+    }
+
+    static Size manual(int viewportWidth, int viewportHeight, double aspect, int percent) {
+        if (isValid(viewportWidth, viewportHeight, aspect)) {
+            double scale = clampManualPercent(percent) / 100.0;
+            double width = Math.min(viewportWidth, viewportHeight * aspect);
+            long w = Math.round(width * scale);
+            long h = Math.round(width / aspect * scale);
+            if (isLayoutSize(w) && isLayoutSize(h)) return new Size((int) w, (int) h);
+        }
+        return new Size(viewportWidth, viewportHeight);
+    }
+
+    private static boolean isValid(int width, int height, double aspect) {
+        return width > 0 && height > 0 && aspect > 0
+                && !Double.isNaN(aspect) && !Double.isInfinite(aspect);
+    }
+
+    private static boolean isLayoutSize(long size) {
+        return size > 0 && size <= MAX_LAYOUT_SIZE;
+    }
+
+    static final class Size {
+        final int width;
+        final int height;
+
+        Size(int width, int height) {
+            this.width = width;
+            this.height = height;
+        }
+    }
+}
diff --git a/test/SubtitleDelayPreferenceTest.java b/test/SubtitleDelayPreferenceTest.java
new file mode 100644
index 0000000..8ef7228
--- /dev/null
+++ b/test/SubtitleDelayPreferenceTest.java
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.archos.mediacenter.video.player;
+
+import android.content.SharedPreferences;
+
+import java.lang.reflect.Proxy;
+import java.util.HashMap;
+import java.util.Map;
+
+/** Standalone test; only the SharedPreferences storage interface is faked. */
+public final class SubtitleDelayPreferenceTest {
+    public static void main(String[] args) {
+        Store store = new Store();
+        SharedPreferences prefs = store.open();
+        check(SubtitleDelayPreference.isEnabled(prefs), "memory enabled by default");
+        check(SubtitleDelayPreference.resolve(prefs, -180) == -180, "fallback to file value");
+        check(store.writes == 0, "opening/reading must not persist a value");
+
+        check(SubtitleDelayPreference.saveIfEnabled(prefs, 240), "save positive offset");
+        check(SubtitleDelayPreference.resolve(store.open(), -180) == 240, "restore positive offset");
+        check(SubtitleDelayPreference.saveIfEnabled(prefs, -320), "save negative offset");
+        check(SubtitleDelayPreference.resolve(store.open(), 800) == -320, "restore negative offset");
+        check(SubtitleDelayPreference.saveIfEnabled(prefs, 0), "explicitly save neutral offset");
+        check(SubtitleDelayPreference.resolve(store.open(), -180) == 0, "zero is not a missing value");
+
+        SubtitleDelayPreference.setEnabled(prefs, false, 0);
+        int writesAfterDisable = store.writes;
+        check(!SubtitleDelayPreference.saveIfEnabled(prefs, 900), "local edit must bypass global memory");
+        check(store.writes == writesAfterDisable, "disabled edits must not overwrite global memory");
+        check(SubtitleDelayPreference.resolve(store.open(), -180, 0) == 0, "toggle off keeps current session including zero");
+        check(SubtitleDelayPreference.resolve(store.open(), -180, -375) == -375, "metadata refresh keeps disabled current session");
+        check(SubtitleDelayPreference.resolve(store.open(), -180) == -180, "next playback restores file fallback");
+        check(store.values.size() == 1, "turning memory off removed the global delay");
+        SubtitleDelayPreference.setEnabled(prefs, true, -135);
+        check(SubtitleDelayPreference.resolve(store.open(), 1000) == -135, "reenabling captures current exact offset");
+        System.out.println("Subtitle delay positive/negative/reset, restore, local fallback and write guards passed");
+    }
+
+    private static void check(boolean condition, String description) {
+        if (!condition) throw new AssertionError(description);
+    }
+
+    private static final class Store {
+        private final Map<String, Object> values = new HashMap<>();
+        private int writes;
+
+        SharedPreferences open() {
+            return (SharedPreferences) Proxy.newProxyInstance(getClass().getClassLoader(),
+                    new Class<?>[]{SharedPreferences.class}, (proxy, method, args) ->
+                    switch (method.getName()) {
+                        case "getBoolean", "getInt" -> values.getOrDefault((String) args[0], args[1]);
+                        case "contains" -> values.containsKey((String) args[0]);
+                        case "edit" -> editor();
+                        default -> throw new AssertionError(method);
+                    });
+        }
+
+        SharedPreferences.Editor editor() {
+            Map<String, Object> pending = new HashMap<>();
+            return (SharedPreferences.Editor) Proxy.newProxyInstance(getClass().getClassLoader(),
+                    new Class<?>[]{SharedPreferences.Editor.class}, (proxy, method, args) ->
+                    switch (method.getName()) {
+                        case "putBoolean", "putInt" -> {
+                            pending.put((String) args[0], args[1]);
+                            yield proxy;
+                        }
+                        case "remove" -> {
+                            pending.put((String) args[0], null);
+                            yield proxy;
+                        }
+                        case "apply" -> {
+                            pending.forEach((key, value) -> {
+                                if (value == null) values.remove(key);
+                                else values.put(key, value);
+                            });
+                            writes++;
+                            yield null;
+                        }
+                        default -> throw new AssertionError(method);
+                    });
+        }
+    }
+}
diff --git a/test/VideoZoomLayoutTest.java b/test/VideoZoomLayoutTest.java
new file mode 100644
index 0000000..79abed9
--- /dev/null
+++ b/test/VideoZoomLayoutTest.java
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.archos.mediacenter.video.player;
+
+/** Standalone geometry tests: see the javac/java commands in the patch handoff. */
+public final class VideoZoomLayoutTest {
+    public static void main(String[] args) {
+        manual();
+        modes();
+        System.out.println("Manual zoom geometry, 1-point steps, and stock menu/migration regressions passed");
+    }
+
+    private static void manual() {
+        // A 100% manual reset fits the complete picture.
+        check(VideoZoomLayout.manual(1920, 1080, 2.4, 100), 1920, 800);
+        check(VideoZoomLayout.manual(1920, 1080, 2.4, 125), 2400, 1000);
+        check(VideoZoomLayout.manual(1920, 1080, 4.0 / 3, 150), 2160, 1620);
+        check(VideoZoomLayout.manual(1920, 1080, 9.0 / 16, 200), 1215, 2160);
+        // Baked fixture: 268 picture rows inside a 360-row 16:9 frame.
+        VideoZoomLayout.Size at130 = VideoZoomLayout.manual(1920, 1080, 16.0 / 9, 130);
+        VideoZoomLayout.Size at140 = VideoZoomLayout.manual(1920, 1080, 16.0 / 9, 140);
+        if (at130.height * 268 < 1080 * 360 && at140.height * 268 >= 1080 * 360) {
+            check(at140, 2688, 1512);
+        } else {
+            throw new AssertionError("Baked bars must remain at 130% and be outside the viewport at 140%");
+        }
+        check(VideoZoomLayout.manual(1920, 1080, 16.0 / 9, 0), 1920, 1080);
+        check(VideoZoomLayout.manual(1920, 1080, 16.0 / 9, 999), 3840, 2160);
+        check(VideoZoomLayout.manual(1920, 1080, Double.NaN, 150), 1920, 1080);
+        // A value saved by an older version remains exact; each new step moves only 1 point.
+        if (VideoZoomLayout.clampManualPercent(145) != 145) {
+            throw new AssertionError("Persisted valid percent changed on load");
+        }
+        percent(100, false, 100);
+        percent(100, true, 101);
+        percent(145, true, 146);
+        percent(145, false, 144);
+        percent(101, false, 100);
+        percent(199, true, 200);
+        percent(200, true, 200);
+    }
+
+    private static void percent(int before, boolean increase, int expected) {
+        int actual = VideoZoomLayout.stepManualPercent(before, increase);
+        if (actual != expected) {
+            throw new AssertionError("Expected " + expected + "%, got " + actual + "%");
+        }
+    }
+
+    private static void modes() {
+        int[] fullOrder = {0, 1, 2, 3, 4, 5, 6, 7};
+        int[] standardOrder = {0, 1, 2, 3, 4, 5, 6};
+        if (!java.util.Arrays.equals(fullOrder, VideoDisplayMode.cycleIds(true))
+                || !java.util.Arrays.equals(standardOrder, VideoDisplayMode.cycleIds(false))) {
+            throw new AssertionError("Changed stock order or AUTO eligibility");
+        }
+        for (int i = 0; i < fullOrder.length; i++) {
+            if (VideoDisplayMode.fromTvMenuPosition(i + 1) != fullOrder[i]
+                    || VideoDisplayMode.toTvMenuPosition(fullOrder[i]) != i + 1
+                    || VideoDisplayMode.indexForStoredFormat(fullOrder, fullOrder[i]) != i) {
+                throw new AssertionError("Stock TV row/stored ID round trip failed for " + i);
+            }
+        }
+        if (VideoDisplayMode.fromTvMenuPosition(-1) != -1
+                || VideoDisplayMode.fromTvMenuPosition(0) != -1
+                || VideoDisplayMode.fromTvMenuPosition(fullOrder.length + 1) != -1
+                || VideoDisplayMode.toTvMenuPosition(8) != -1
+                || VideoDisplayMode.toTvMenuPosition(9) != -1) {
+            throw new AssertionError("Manual or non-format rows mapped to a stock ID");
+        }
+        for (int[] slot : new int[][] {standardOrder, fullOrder}) {
+            for (int invalid : new int[] {-1, 8, 9, 100}) {
+                int index = VideoDisplayMode.indexForStoredFormat(slot, invalid);
+                if (slot[index] != VideoDisplayMode.ORIGINAL) {
+                    throw new AssertionError("Removed/unrecognized ID did not fall back to Original: " + invalid);
+                }
+            }
+        }
+    }
+
+    private static void check(VideoZoomLayout.Size actual, int w, int h) {
+        if (actual.width != w || actual.height != h) {
+            throw new AssertionError("Expected " + w + "x" + h + ", got "
+                    + actual.width + "x" + actual.height);
+        }
+    }
+}
