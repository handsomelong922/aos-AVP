index 0000000..1db2b5e
--- /dev/null
+++ b/src/main/java/com/archos/mediacenter/video/player/SubtitleDelayPreference.java
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.archos.mediacenter.video.player;
+
+import android.content.SharedPreferences;
+
+/** App-wide subtitle offset, separate from each video's existing database value. */
+final class SubtitleDelayPreference {
+    private static final String KEY_ENABLED = "player_pref_keep_subtitle_delay";
+    private static final String KEY_DELAY = "player_pref_saved_subtitle_delay_ms";
+
+    private SubtitleDelayPreference() {}
+
+    static boolean isEnabled(SharedPreferences preferences) {
+        return preferences.getBoolean(KEY_ENABLED, true);
+    }
+
+    static int resolve(SharedPreferences preferences, int fileDelay) {
+        return resolve(preferences, fileDelay, null);
+    }
+
+    static int resolve(SharedPreferences preferences, int fileDelay, Integer sessionDelay) {
+        if (isEnabled(preferences)) return preferences.getInt(KEY_DELAY, fileDelay);
+        return sessionDelay != null ? sessionDelay : fileDelay;
+    }
+
+    static boolean saveIfEnabled(SharedPreferences preferences, int delay) {
+        if (!isEnabled(preferences)) return false;
+        preferences.edit().putInt(KEY_DELAY, delay).apply();
+        return true;
+    }
+
+    static void setEnabled(SharedPreferences preferences, boolean enabled, int currentDelay) {
+        SharedPreferences.Editor editor = preferences.edit().putBoolean(KEY_ENABLED, enabled);
+        if (enabled) editor.putInt(KEY_DELAY, currentDelay);
+        else editor.remove(KEY_DELAY);
+        editor.apply();
+    }
+}
