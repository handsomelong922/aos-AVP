diff --git a/src/main/java/com/archos/mediacenter/video/player/VideoDisplayMode.java b/src/main/java/com/archos/mediacenter/video/player/VideoDisplayMode.java
new file mode 100644
index 0000000000000000000000000000000000000000..e268b772e3e1acbc475669f0d044184435d29470
--- /dev/null
+++ b/src/main/java/com/archos/mediacenter/video/player/VideoDisplayMode.java
@@ -0,0 +1,47 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.archos.mediacenter.video.player;
+
+/** Stable preference IDs, independent of remote menu and button-cycle positions. */
+final class VideoDisplayMode {
+    static final int ORIGINAL = 0;
+    static final int STRETCH_XY = 1;
+    static final int FULL_SCREEN = 2;
+    static final int FORCE43 = 3;
+    static final int FORCE169 = 4;
+    static final int FORCE185 = 5;
+    static final int FORCE239 = 6;
+    static final int AUTO = 7;
+    static final int FIT_HEIGHT = 8;
+    static final int FIT_EITHER = 9;
+
+    // Element order matches pref_format_mode_entries. Keep the existing rows/IDs intact.
+    private static final int[] TV_MENU_IDS = {
+            ORIGINAL, STRETCH_XY, FULL_SCREEN, FORCE43, FORCE169, FORCE185, FORCE239, AUTO,
+            FIT_HEIGHT, FIT_EITHER
+    };
+
+    private VideoDisplayMode() {}
+
+    static int[] cycleIds(boolean allowOptimized) {
+        if (allowOptimized) return TV_MENU_IDS.clone();
+        int[] ids = new int[TV_MENU_IDS.length - 1];
+        int count = 0;
+        for (int id : TV_MENU_IDS) {
+            if (id != AUTO) ids[count++] = id;
+        }
+        return ids;
+    }
+
+    static int fromTvMenuPosition(int position) {
+        return position >= 0 && position < TV_MENU_IDS.length ? TV_MENU_IDS[position] : -1;
+    }
+
+    static int toTvMenuPosition(int id) {
+        for (int i = 0; i < TV_MENU_IDS.length; i++) {
+            if (TV_MENU_IDS[i] == id) return i;
+        }
+        return -1;
+    }
+}
diff --git a/src/main/java/com/archos/mediacenter/video/player/VideoZoomLayout.java b/src/main/java/com/archos/mediacenter/video/player/VideoZoomLayout.java
new file mode 100644
index 0000000000000000000000000000000000000000..8fc6dc5b3fe72d4af5d3b633b9ca3def04efd469
--- /dev/null
+++ b/src/main/java/com/archos/mediacenter/video/player/VideoZoomLayout.java
@@ -0,0 +1,76 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.archos.mediacenter.video.player;
+
+/** Aspect-preserving destination size; intentionally independent of the decoded buffer size. */
+final class VideoZoomLayout {
+    // Largest size representable by Android's 30-bit MeasureSpec size field.
+    private static final int MAX_LAYOUT_SIZE = 0x3fffffff;
+
+    static final int MANUAL_MIN_PERCENT = 100;
+    private static final int MANUAL_MAX_PERCENT = 200;
+    private static final int MANUAL_STEP_PERCENT = 3;
+
+    private VideoZoomLayout() {}
+
+    static int clampManualPercent(int percent) {
+        return Math.min(MANUAL_MAX_PERCENT, Math.max(MANUAL_MIN_PERCENT, percent));
+    }
+
+    static int stepManualPercent(int percent, boolean increase) {
+        return clampManualPercent(clampManualPercent(percent)
+                + (increase ? MANUAL_STEP_PERCENT : -MANUAL_STEP_PERCENT));
+    }
+
+    static Size manual(int viewportWidth, int viewportHeight, double aspect, int percent) {
+        if (isValid(viewportWidth, viewportHeight, aspect)) {
+            double scale = clampManualPercent(percent) / 100.0;
+            double width = Math.min(viewportWidth, viewportHeight * aspect);
+            long w = Math.round(width * scale);
+            long h = Math.round(width / aspect * scale);
+            if (isLayoutSize(w) && isLayoutSize(h)) return new Size((int) w, (int) h);
+        }
+        return new Size(viewportWidth, viewportHeight);
+    }
+
+    static Size fitHeight(int viewportWidth, int viewportHeight, double aspect) {
+        if (isValid(viewportWidth, viewportHeight, aspect)) {
+            long width = Math.round(viewportHeight * aspect);
+            if (isLayoutSize(width)) return new Size((int) width, viewportHeight);
+        }
+        return new Size(viewportWidth, viewportHeight);
+    }
+
+    static Size cover(int viewportWidth, int viewportHeight, double aspect) {
+        if (isValid(viewportWidth, viewportHeight, aspect)) {
+            if (aspect >= (double) viewportWidth / viewportHeight) {
+                long width = (long) Math.ceil(viewportHeight * aspect);
+                if (isLayoutSize(width)) return new Size(Math.max(viewportWidth, (int) width), viewportHeight);
+            } else {
+                long height = (long) Math.ceil(viewportWidth / aspect);
+                if (isLayoutSize(height)) return new Size(viewportWidth, Math.max(viewportHeight, (int) height));
+            }
+        }
+        return new Size(viewportWidth, viewportHeight);
+    }
+
+    private static boolean isValid(int width, int height, double aspect) {
+        return width > 0 && height > 0 && aspect > 0
+                && !Double.isNaN(aspect) && !Double.isInfinite(aspect);
+    }
+
+    private static boolean isLayoutSize(long size) {
+        return size > 0 && size <= MAX_LAYOUT_SIZE;
+    }
+
+    static final class Size {
+        final int width;
+        final int height;
+
+        Size(int width, int height) {
+            this.width = width;
+            this.height = height;
+        }
+    }
+}
