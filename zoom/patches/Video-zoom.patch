diff --git a/src/main/java/com/archos/mediacenter/video/player/VideoDisplayMode.java b/src/main/java/com/archos/mediacenter/video/player/VideoDisplayMode.java
new file mode 100644
index 0000000..fd87375
--- /dev/null
+++ b/src/main/java/com/archos/mediacenter/video/player/VideoDisplayMode.java
@@ -0,0 +1,57 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.archos.mediacenter.video.player;
+
+/** Stable preference IDs, independent of remote menu and button-cycle positions. */
+final class VideoDisplayMode {
+    static final int ORIGINAL = 0;
+    static final int STRETCH_XY = 1;
+    static final int FULL_SCREEN = 2;
+    static final int FORCE43 = 3;
+    static final int FORCE169 = 4;
+    static final int FORCE185 = 5;
+    static final int FORCE239 = 6;
+    static final int AUTO = 7;
+    // IDs 8 and 9 previously selected custom modes; never reuse persisted IDs.
+
+    // Stock entries follow the manual zoom row in the TV menu.
+    private static final int FIRST_STOCK_TV_MENU_POSITION = 1;
+
+    // Element order matches pref_format_mode_entries. Keep the existing rows/IDs intact.
+    private static final int[] TV_MENU_IDS = {
+            ORIGINAL, STRETCH_XY, FULL_SCREEN, FORCE43, FORCE169, FORCE185, FORCE239, AUTO
+    };
+
+    private VideoDisplayMode() {}
+
+    static int[] cycleIds(boolean allowOptimized) {
+        if (allowOptimized) return TV_MENU_IDS.clone();
+        int[] ids = new int[TV_MENU_IDS.length - 1];
+        int count = 0;
+        for (int id : TV_MENU_IDS) {
+            if (id != AUTO) ids[count++] = id;
+        }
+        return ids;
+    }
+
+    static int fromTvMenuPosition(int position) {
+        int index = position - FIRST_STOCK_TV_MENU_POSITION;
+        return index >= 0 && index < TV_MENU_IDS.length ? TV_MENU_IDS[index] : -1;
+    }
+
+    static int toTvMenuPosition(int id) {
+        for (int i = 0; i < TV_MENU_IDS.length; i++) {
+            if (TV_MENU_IDS[i] == id) return i + FIRST_STOCK_TV_MENU_POSITION;
+        }
+        return -1;
+    }
+
+    static int indexForStoredFormat(int[] availableModes, int id) {
+        for (int i = 0; i < availableModes.length; i++) {
+            if (availableModes[i] == id) return i;
+        }
+        // Original is the first cycle entry in both slots.
+        return 0;
+    }
+}
