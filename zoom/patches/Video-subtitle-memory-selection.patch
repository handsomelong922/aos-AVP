+/* SPDX-License-Identifier: Apache-2.0 */
+package com.archos.mediacenter.video.player;
+
+import android.net.Uri;
+
+import com.archos.filecorelibrary.FileUtils;
+import com.archos.mediacenter.video.browser.subtitlesmanager.LocalSubtitleMatch;
+import com.archos.mediacenter.video.browser.subtitlesmanager.SubtitleManager;
+import com.archos.mediacenter.video.utils.VideoMetadata;
+
+import java.io.File;
+import java.util.HashMap;
+import java.util.Map;
+
+/** Identity and eligibility for this one local playback source. */
+final class LocalSubtitleSelection {
+    final String videoKey;
+    final String seriesKey;
+    private final String mVideoName;
+    private final String mVideoIdentity;
+    private final File mCacheDir;
+    private final File mDirectDir;
+
+    LocalSubtitleSelection(Uri video, File cacheDir) {
+        mVideoIdentity = SubtitleManager.localVideoIdentity(video);
+        mVideoName = LocalSubtitleMatch.leaf(FileUtils.getName(video));
+        videoKey = SubtitleMemoryPolicy.videoKey(mVideoIdentity);
+        String series = LocalSubtitleMatch.series(mVideoName);
+        Uri parent = series != null ? FileUtils.getParentUrl(video) : null;
+        seriesKey = parent != null ? SubtitleMemoryPolicy.seriesKey(SubtitleManager.localVideoIdentity(parent), series) : null;
+        mCacheDir = cacheDir;
+        mDirectDir = "content".equalsIgnoreCase(video.getScheme()) ? null
+                : new File(Uri.decode(mVideoIdentity)).getParentFile();
+    }
+
+    boolean eligible(VideoMetadata.SubtitleTrack track) {
+        if (track == null) return false;
+        if (!track.isExternal) return true;
+        String path = trackPath(track.path);
+        String name = LocalSubtitleMatch.leaf(path);
+        if (LocalSubtitleMatch.hasOwnedMarker(name)) return cachedVariant(name) != null;
+        // Native retains its normal movie handling. For episodic playback do not
+        // choose an old unnamed or basename-only copy from the shared legacy cache.
+        if (seriesKey == null) return true;
+        return !isLegacyCache(path) && mDirectDir != null
+                && mDirectDir.equals(new File(path).getParentFile()) && LocalSubtitleMatch.matches(mVideoName, name);
+    }
+
+    String[] identities(VideoMetadata metadata) {
+        String[] result = new String[metadata.getSubtitleTrackNb()];
+        Map<String, Integer> occurrences = new HashMap<>();
+        for (int i = 0; i < result.length; i++) {
+            VideoMetadata.SubtitleTrack track = metadata.getSubtitleTrack(i);
+            if (track == null) continue;
+            if (track.isExternal) {
+                String path = trackPath(track.path);
+                if (!isLegacyCache(path) || cachedVariant(LocalSubtitleMatch.leaf(path)) != null)
+                    result[i] = SubtitleMemoryPolicy.external(path, "");
+            } else {
+                String identity = SubtitleMemoryPolicy.embedded(track.name, track.language,
+                        track.kind, track.format, track.disposition);
+                int ordinal = occurrences.containsKey(identity) ? occurrences.get(identity) : 0;
+                occurrences.put(identity, ordinal + 1);
+                result[i] = SubtitleMemoryPolicy.withOrdinal(identity, ordinal);
+            }
+        }
+        return result;
+    }
+
+    String variant(VideoMetadata.SubtitleTrack track) {
+        if (seriesKey == null || track == null || !track.isExternal || !eligible(track)) return null;
+        String path = trackPath(track.path);
+        String name = LocalSubtitleMatch.leaf(path);
+        String cached = cachedVariant(name);
+        if (cached != null) return cached.startsWith("manual.") ? "owned:" : "cache:" + cached;
+        String direct = LocalSubtitleMatch.variant(mVideoName, name);
+        return direct != null ? "direct:" + direct : null;
+    }
+
+    int matchingAssociation(VideoMetadata metadata, String path) {
+        if (path == null) return -1;
+        path = trackPath(path);
+        if (isLegacyCache(path) && cachedVariant(LocalSubtitleMatch.leaf(path)) == null) return -1;
+        int match = -1;
+        for (int i = 0; i < metadata.getSubtitleTrackNb(); i++) {
+            VideoMetadata.SubtitleTrack track = metadata.getSubtitleTrack(i);
+            if (track != null && track.isExternal && path.equals(trackPath(track.path))) {
+                if (match != -1) return -1;
+                match = i;
+            }
+        }
+        return match;
+    }
+
+    private boolean isLegacyCache(String path) {
+        return mCacheDir != null && mCacheDir.equals(new File(path).getParentFile());
+    }
+
+    private String cachedVariant(String name) {
+        return LocalSubtitleMatch.cachedVariant(mVideoName, mVideoIdentity, name);
+    }
+
+    private static String trackPath(String path) {
+        if (path == null) return "";
+        if (path.startsWith("file://")) {
+            String decoded = Uri.parse(path).getPath();
+            if (decoded != null) return decoded;
+        }
+        return path;
+    }
+}
