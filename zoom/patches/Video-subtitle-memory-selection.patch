index 0000000000000000000000000000000000000000..2dbc32be78ab17f698867a3cc744eb5ca2ba7f87
--- /dev/null
+++ b/src/main/java/com/archos/mediacenter/video/player/SubtitleMemoryPolicy.java
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.archos.mediacenter.video.player;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+
+final class SubtitleMemoryPolicy {
+    static final String NONE = "none";
+
+    private SubtitleMemoryPolicy() {}
+
+    static String videoKey(String identity) {
+        return "player_manual_subtitle_" + hash(identity);
+    }
+
+    static String seriesKey(String parentIdentity, String series) {
+        return "player_subtitle_series_" + hash(parentIdentity, series);
+    }
+
+    static String external(String path, String cacheFingerprint) {
+        return "file:" + hash(path, cacheFingerprint);
+    }
+
+    static String embedded(String name, String language, int kind, int format, int disposition) {
+        return "embedded:" + hash(name, language, Integer.toString(kind), Integer.toString(format),
+                Integer.toString(disposition));
+    }
+
+    static String withOrdinal(String embeddedIdentity, int ordinal) {
+        return embeddedIdentity + ":" + ordinal;
+    }
+
+    /** Returns -1 for absent/ambiguous choices; NONE resolves independently of track count. */
+    static int find(String wanted, String[] available) {
+        if (NONE.equals(wanted)) return available.length;
+        if (wanted == null) return -1;
+        int match = -1;
+        for (int i = 0; i < available.length; i++) {
+            if (wanted.equals(available[i])) {
+                if (match != -1) return -1;
+                match = i;
+            }
+        }
+        return match;
+    }
+
+    /** A single proven file is safe even if its naming/source style changed after an episode. */
+    static int chooseSeriesVariant(String learned, String[] eligible) {
+        if (learned == null) return -1;
+        int exact = learned.isEmpty() ? -1 : find(learned, eligible);
+        if (exact >= 0) return exact;
+        int unique = -1;
+        for (int i = 0; i < eligible.length; i++) {
+            if (eligible[i] == null) continue;
+            if (unique >= 0) return -1;
+            unique = i;
+        }
+        return unique;
+    }
+
+    private static String hash(String... values) {
+        try {
+            MessageDigest digest = MessageDigest.getInstance("SHA-256");
+            for (String value : values) {
+                if (value != null) digest.update(value.getBytes(StandardCharsets.UTF_8));
+                digest.update((byte) 0);
+            }
+            return toHex(digest.digest());
+        } catch (NoSuchAlgorithmException e) {
+            throw new AssertionError("Android requires SHA-256", e);
+        }
+    }
+
+    static String toHex(byte[] bytes) {
+        StringBuilder result = new StringBuilder(bytes.length * 2);
+        final String digits = "0123456789abcdef";
+        for (byte b : bytes) {
+            result.append(digits.charAt((b >>> 4) & 15)).append(digits.charAt(b & 15));
+        }
+        return result.toString();
+    }
+}
